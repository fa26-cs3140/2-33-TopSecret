@startuml
title Homework 6 - Member B implemented HTTP controller (November 5, 2026)
package controller {
    enum LaunchMode {
        TERMINAL
        WEB
        CHANGE_PASSWORD
        {static} +fromArguments(arguments : String[]) : LaunchMode
    }
    interface WebAuthentication {
        +hasAccounts() : boolean
        +authenticate(username : String, password : String) : Optional<String>
    }
    interface WebSessionStore {
        +create(username : String) : String
        +usernameFor(token : String) : Optional<String>
        +invalidate(token : String) : void
        +clear() : void
    }
    interface WebServerController {
        {static} PORT : int = 3002
        {static} SESSION_COOKIE : String = "TopSecretSession"
        +start() : void
        +address() : InetSocketAddress
        +close() : void
    }
    class HttpWebServer {
        +HttpWebServer(authentication, sessions, content, bindAddress)
        +start() : void
        +address() : InetSocketAddress
        +close() : void
    }
    class StoredWebAuthentication {
        +StoredWebAuthentication(authentication)
        +hasAccounts() : boolean
        +authenticate(username, password) : Optional<String>
    }
    class InMemoryWebSessionStore {
        +create(username) : String
        +usernameFor(token) : Optional<String>
        +invalidate(token) : void
        +clear() : void
    }
    class ContentController {
        +ContentController(content, authentication)
        +sessionFor(username) : Session
        +canViewAudit(session) : boolean
        +list(type, session) : List<ContentEntry>
        +read(type, id, session) : ContentEntry
        +audit(session) : List<AuditLogEntry>
    }
}
package model {
    class AuthenticationService
    interface ContentService
    class Session
    class AccessControl
    class ContentNotFoundException
}
package view {
    class ContentMenu
    class ContentText
    class HtmlView
}
WebServerController <|.. HttpWebServer
WebAuthentication <|.. StoredWebAuthentication
WebSessionStore <|.. InMemoryWebSessionStore
HttpWebServer --> WebAuthentication
HttpWebServer --> WebSessionStore
HttpWebServer --> ContentController
HttpWebServer --> HtmlView
StoredWebAuthentication --> AuthenticationService
ContentController --> AuthenticationService
ContentController --> ContentService
ContentController --> AccessControl
ContentMenu --> ContentController
ContentMenu --> ContentText
HtmlView --> ContentText
interface "java.lang.AutoCloseable" as AutoCloseable
AutoCloseable <|-- WebServerController
note bottom of WebServerController
  start() declares IOException.
  HttpWebServer binds localhost:3002 in production.
  Tests inject localhost:0.
end note
note bottom of WebAuthentication
  Both methods declare IOException.
  StoredWebAuthentication delegates to AuthenticationService.
end note
@enduml
